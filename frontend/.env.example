# Use the Vite dev proxy so the browser talks to the same origin.
# Vite forwards /api/* to http://127.0.0.1:8000 (see vite.config.ts).
VITE_API_BASE_URL=/api

# Use / for local development or custom-domain deployments.
# Use /job-market-analyzer/ when deploying this repository to GitHub Pages.
VITE_BASE_PATH=/
